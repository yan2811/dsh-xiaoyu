# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=sk-
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 计费（美元/百万 token，2026-08 官方非高峰价；高峰自动 x2）
DEEPSEEK_PRICE_INPUT_MISS=0.22
DEEPSEEK_PRICE_INPUT_HIT=0.007
DEEPSEEK_PRICE_OUTPUT=0.66
DEEPSEEK_USD_CNY=7.2

# 千问视觉 / 语音 API（可选，用于图片识别、语音识别）
DASHSCOPE_API_KEY=sk-

# QQ 接入（NapCat OneBot 11 WebSocket 服务器）
QQ_WS_URL=ws://127.0.0.1:3001
QQ_ACCESS_TOKEN=
QQ_DEFAULT_CHAR_ID=25
QQ_OWNER_ID=
QQ_GROUP_AUTO=
PANEL_TOKEN=
PANEL_PORT=3722

# BreezeBlue TTS（可选，voice.provider=breeze 时使用）
BREEZE_API_KEY=
BREEZE_BASE_URL=https://api.breeze.blue/v1
BREEZE_MODEL=breeze-tts-2
